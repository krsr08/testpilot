FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv tesseract-ocr && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run db:generate && python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r services/worker/requirements-lock.txt
ENV NODE_ENV=production PYTHON_BIN=/opt/venv/bin/python
CMD ["npm","run","worker"]
