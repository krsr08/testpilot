generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  name            String
  externalSubject String?         @unique
  externalId      String?         @unique
  active          Boolean         @default(true)
  provisioningSource String       @default("MANUAL")
  deactivatedAt   DateTime?
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
  memberships     Membership[]
  projectAccess   ProjectMember[]
  preferences     UserPreference?
  notifications   Notification[]
}

model Organization {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String
  slug         String                  @unique
  ssoDomain    String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  workspaces   Workspace[]
  integrations IntegrationConnection[]
  modelRoutes  AgentModelRoute[]
}

model Workspace {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String
  organizationId String                 @db.Uuid
  createdAt      DateTime               @default(now())
  memberships    Membership[]
  projects       Project[]
  subscription   WorkspaceSubscription?
  usageEvents    UsageEvent[]
  webhookEvents  WebhookEvent[]
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WorkspaceSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @unique @db.Uuid
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Membership {
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        Role      @default(TESTER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
}

enum Role {
  ADMIN
  QA_LEAD
  TESTER
  VIEWER
}

model IntegrationConnection {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  kind           String
  name           String
  baseUrl        String
  projectKey     String
  encryptedToken String
  enabled        Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalLinks  ExternalCaseLink[]

  @@unique([organizationId, kind, name])
  @@index([organizationId])
}

model ExternalCaseLink {
  id            String                @id @default(uuid()) @db.Uuid
  testCaseId    String                @db.Uuid
  integrationId String                @db.Uuid
  externalKey   String
  externalUrl   String
  contentHash   String
  syncedAt      DateTime              @default(now())
  testCase      TestCase              @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  integration   IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalKey])
  @@unique([testCaseId, integrationId])
}

model Project {
  id                  String                 @id @default(uuid()) @db.Uuid
  workspaceId         String                 @db.Uuid
  name                String
  description         String                 @default("")
  domain              String                 @default("")
  type                String                 @default("APPLICATION")
  requirementCounter  Int                    @default(0)
  scenarioCounter     Int                    @default(0)
  storyCounter        Int                    @default(0)
  caseCounter         Int                    @default(0)
  version             Int                    @default(1)
  lifecycle           String                 @default("ACTIVE")
  visibility          String                 @default("PRIVATE")
  risk                String                 @default("LOW")
  releaseName         String                 @default("")
  tags                String[]               @default([])
  archivedAt          DateTime?
  createdBy           String                 @db.Uuid
  updatedBy           String                 @db.Uuid
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  workspace           Workspace              @relation(fields: [workspaceId], references: [id])
  sources             SourceDocument[]
  requirements        Requirement[]
  snapshots           RequirementSnapshot[]
  runs                GenerationRun[]
  scenarios           Scenario[]
  testCases           TestCase[]
  jobs                Job[]
  exports             Export[]
  auditEvents         AuditEvent[]
  authoringDocuments  RequirementDocument[]
  feedbackEvents      FeedbackEvent[]
  automationArtifacts AutomationArtifact[]
  changeSets          RequirementChangeSet[]
  members             ProjectMember[]
  testPlans           TestPlan[]
  comments            Comment[]
  userStories         UserStory[]
  externalLinks       ExternalLink[]
  agentRuns           AgentRun[]

  @@unique([workspaceId, name])
  @@index([createdBy, updatedAt])
}

model ProjectMember {
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @default("CONTRIBUTOR")
  addedBy   String   @db.Uuid
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, createdAt])
}

model UserPreference {
  userId             String   @id @db.Uuid
  timezone           String   @default("Asia/Calcutta")
  locale             String   @default("en-IN")
  dateFormat         String   @default("medium")
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  reducedMotion      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  kind      String
  title     String
  message   String
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model UsageEvent {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @db.Uuid
  kind           String
  quantity       Int       @default(1)
  idempotencyKey String
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, kind, createdAt])
}

model WebhookEvent {
  id          String     @id @db.Uuid
  workspaceId String?    @db.Uuid
  provider    String
  eventType   String
  status      String     @default("processed")
  payload     Json       @default("{}")
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
}

model TestPlan {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @db.Uuid
  name        String
  description String      @default("")
  releaseName String      @default("")
  status      String      @default("DRAFT")
  createdBy   String      @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycles      TestCycle[]

  @@index([projectId, updatedAt])
}

model TestCycle {
  id          String          @id @default(uuid()) @db.Uuid
  testPlanId  String          @db.Uuid
  name        String
  environment String          @default("QA")
  status      String          @default("PLANNED")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  testPlan    TestPlan        @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  executions  TestExecution[]

  @@index([testPlanId, createdAt])
}

model TestExecution {
  id          String    @id @default(uuid()) @db.Uuid
  testCycleId String    @db.Uuid
  testCaseId  String    @db.Uuid
  status      String    @default("NOT_RUN")
  notes       String    @default("")
  evidence    Json      @default("[]")
  executedBy  String?   @db.Uuid
  executedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  testCycle   TestCycle @relation(fields: [testCycleId], references: [id], onDelete: Cascade)
  testCase    TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCycleId, testCaseId])
  @@index([testCycleId, status])
}

model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  entityType String
  entityId   String    @db.Uuid
  body       String
  authorId   String    @db.Uuid
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, entityType, entityId, createdAt])
}

model RequirementDocument {
  id           String                        @id @default(uuid()) @db.Uuid
  projectId    String                        @db.Uuid
  title        String
  templateType String                        @default("SIMPLE_PRD")
  content      String
  status       String                        @default("DRAFT")
  version      Int                           @default(1)
  createdBy    String                        @db.Uuid
  updatedBy    String                        @db.Uuid
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  project      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions    RequirementDocumentRevision[]

  @@index([projectId, updatedAt])
}

model RequirementDocumentRevision {
  id         String              @id @default(uuid()) @db.Uuid
  documentId String              @db.Uuid
  version    Int
  title      String
  content    String
  createdBy  String              @db.Uuid
  createdAt  DateTime            @default(now())
  document   RequirementDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model SourceDocument {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  filename     String
  mime         String
  sha256       String
  storageKey   String
  size         Int
  text         String           @default("")
  pageMap      Json             @default("[]")
  pageCount    Int?
  warnings     Json             @default("[]")
  status       String           @default("queued")
  error        String?
  version      Int              @default(1)
  createdBy    String           @db.Uuid
  updatedBy    String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  project      Project          @relation(fields: [projectId], references: [id])
  requirements Requirement[]
  citations    SourceCitation[]

  @@index([projectId, createdAt])
}

model Requirement {
  id               String                 @id @default(uuid()) @db.Uuid
  projectId        String                 @db.Uuid
  sourceId         String?                @db.Uuid
  stableCode       String
  text             String
  sourceLocator    Json                   @default("{}")
  excerpt          String                 @default("")
  confidence       String                 @default("review")
  category         String                 @default("FUNCTIONAL_REQUIREMENT")
  parentStory      String                 @default("")
  inferred         Boolean                @default(false)
  revision         Int                    @default(1)
  version          Int                    @default(1)
  included         Boolean                @default(true)
  status           String                 @default("draft")
  outOfScopeReason String?
  createdBy        String                 @db.Uuid
  updatedBy        String                 @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  project          Project                @relation(fields: [projectId], references: [id])
  source           SourceDocument?        @relation(fields: [sourceId], references: [id])
  links            RequirementCaseLink[]
  revisions        RequirementRevision[]
  storyLinks       StoryRequirementLink[]

  @@unique([projectId, stableCode])
  @@index([projectId, createdAt])
}

model UserStory {
  id                 String                 @id @default(uuid()) @db.Uuid
  projectId          String                 @db.Uuid
  stableCode         String
  title              String
  narrative          String
  acceptanceCriteria Json                   @default("[]")
  sourceSpanRef      Json
  critiqueStatus     String                 @default("PENDING")
  critiqueReason     String                 @default("")
  state              String                 @default("DRAFT")
  reviewReason       String                 @default("")
  reviewerId         String?                @db.Uuid
  version            Int                    @default(1)
  parentStoryId      String?                @db.Uuid
  createdBy          String                 @db.Uuid
  authorKind         String                 @default("USER")
  generatedByRunId   String?                @db.Uuid
  verifiedByRunId    String?                @db.Uuid
  updatedBy          String                 @db.Uuid
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  archivedAt         DateTime?
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentStory        UserStory?             @relation("StoryLineage", fields: [parentStoryId], references: [id], onDelete: SetNull)
  children           UserStory[]            @relation("StoryLineage")
  requirementLinks   StoryRequirementLink[]
  revisions          UserStoryRevision[]
  scenarios          Scenario[]
  externalLinks      ExternalLink[]

  @@unique([projectId, stableCode])
  @@index([projectId, state, updatedAt])
  @@index([reviewerId, state, updatedAt])
}

model StoryRequirementLink {
  storyId       String      @db.Uuid
  requirementId String      @db.Uuid
  sourceSpanRef Json
  createdAt     DateTime    @default(now())
  story         UserStory   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([storyId, requirementId])
  @@index([requirementId])
}

model UserStoryRevision {
  id        String    @id @default(uuid()) @db.Uuid
  storyId   String    @db.Uuid
  version   Int
  data      Json
  reason    String    @default("")
  createdBy String    @db.Uuid
  createdAt DateTime  @default(now())
  story     UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, version])
}

model ExternalLink {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @db.Uuid
  storyId        String?    @db.Uuid
  entityType     String
  entityId       String     @db.Uuid
  externalSystem String
  externalId     String
  externalUrl    String
  syncedAt       DateTime   @default(now())
  revision       String     @default("")
  status         String     @default("SYNCED")
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story          UserStory? @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([externalSystem, externalId])
  @@index([projectId, entityType, entityId])
}

model RequirementRevision {
  id            String      @id @default(uuid()) @db.Uuid
  requirementId String      @db.Uuid
  revision      Int
  data          Json
  createdBy     String      @db.Uuid
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@unique([requirementId, revision])
}

model RequirementSnapshot {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  hash      String
  items     Json
  createdBy String          @db.Uuid
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id])
  runs      GenerationRun[]

  @@unique([projectId, hash])
}

model GenerationRun {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  snapshotId     String              @db.Uuid
  snapshotHash   String
  idempotencyKey String
  modelId        String
  promptVersion  String
  provider       String              @default("fixture")
  types          Json
  settings       Json                @default("{}")
  status         String              @default("queued")
  error          String?
  warnings       Json                @default("[]")
  startedAt      DateTime?
  completedAt    DateTime?
  createdBy      String              @db.Uuid
  createdAt      DateTime            @default(now())
  project        Project             @relation(fields: [projectId], references: [id])
  snapshot       RequirementSnapshot @relation(fields: [snapshotId], references: [id])
  scenarios      Scenario[]
  testCases      TestCase[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, snapshotHash, status])
}

model Scenario {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  runId       String?        @db.Uuid
  storyId     String?        @db.Uuid
  stableCode  String
  title       String
  description String         @default("")
  status      String         @default("draft")
  version     Int            @default(1)
  generatedByRunId String?   @db.Uuid
  verifiedByRunId  String?   @db.Uuid
  createdBy   String         @db.Uuid
  updatedBy   String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id])
  run         GenerationRun? @relation(fields: [runId], references: [id])
  story       UserStory?     @relation(fields: [storyId], references: [id], onDelete: SetNull)
  testCases   TestCase[]

  @@unique([projectId, stableCode])
}

model TestCase {
  id                  String                @id @default(uuid()) @db.Uuid
  projectId           String                @db.Uuid
  scenarioId          String?               @db.Uuid
  runId               String?               @db.Uuid
  stableCode          String
  title               String
  type                String                @default("positive")
  executionType       String                @default("MANUAL")
  priority            String                @default("medium")
  preconditions       String                @default("")
  testData            String                @default("")
  postconditions      String                @default("")
  rationale           String                @default("")
  reviewerNotes       String                @default("")
  status              String                @default("draft")
  stale               Boolean               @default(false)
  manual              Boolean               @default(false)
  version             Int                   @default(1)
  generatedByRunId    String?               @db.Uuid
  verifiedByRunId     String?               @db.Uuid
  createdBy           String                @db.Uuid
  updatedBy           String                @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  project             Project               @relation(fields: [projectId], references: [id])
  scenario            Scenario?             @relation(fields: [scenarioId], references: [id])
  run                 GenerationRun?        @relation(fields: [runId], references: [id])
  steps               TestStep[]
  links               RequirementCaseLink[]
  revisions           TestCaseRevision[]
  externalLinks       ExternalCaseLink[]
  feedbackEvents      FeedbackEvent[]
  automationArtifacts AutomationArtifact[]
  testExecutions      TestExecution[]

  @@unique([projectId, stableCode])
  @@index([projectId, status, createdAt])
}

model FeedbackEvent {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  testCaseId  String?   @db.Uuid
  category    String
  disposition String
  original    Json?
  corrected   Json?
  note        String    @default("")
  createdBy   String    @db.Uuid
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase    TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  @@index([projectId, category, createdAt])
}

model AutomationArtifact {
  id         String                       @id @default(uuid()) @db.Uuid
  projectId  String                       @db.Uuid
  testCaseId String                       @db.Uuid
  framework  String                       @default("playwright")
  filename   String
  source     String
  selectors  Json                         @default("[]")
  status     String                       @default("draft")
  version    Int                          @default(1)
  generatedByRunId String?                @db.Uuid
  verifiedByRunId  String?                @db.Uuid
  createdBy  String                       @db.Uuid
  updatedBy  String                       @db.Uuid
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  project    Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase   TestCase                     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  repairs    AutomationRepairSuggestion[]

  @@unique([testCaseId, framework])
  @@index([projectId, updatedAt])
  @@index([generatedByRunId])
  @@index([verifiedByRunId])
}

model AutomationRepairSuggestion {
  id              String             @id @default(uuid()) @db.Uuid
  artifactId      String             @db.Uuid
  failedSelector  Json
  workingSelector Json
  proposedSource  String
  status          String             @default("pending")
  generatedByRunId String?           @db.Uuid
  createdBy       String             @db.Uuid
  reviewedBy      String?            @db.Uuid
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
  artifact        AutomationArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, status, createdAt])
  @@index([generatedByRunId])
}

model RequirementChangeSet {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  fromSnapshot String?
  toSnapshot   String
  summary      Json
  changes      Json
  createdBy    String   @db.Uuid
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, toSnapshot])
  @@index([projectId, createdAt])
}

model TestStep {
  id             String   @id @default(uuid()) @db.Uuid
  testCaseId     String   @db.Uuid
  position       Int
  action         String
  expectedResult String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, position])
}

model RequirementCaseLink {
  requirementId String      @db.Uuid
  testCaseId    String      @db.Uuid
  rationale     String      @default("")
  createdBy     String      @db.Uuid
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  testCase      TestCase    @relation(fields: [testCaseId], references: [id])

  @@id([requirementId, testCaseId])
}

model SourceCitation {
  id         String          @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String          @db.Uuid
  sourceId   String?         @db.Uuid
  locator    Json            @default("{}")
  quote      String          @default("")
  inferred   Boolean         @default(false)
  source     SourceDocument? @relation(fields: [sourceId], references: [id])

  @@index([entityType, entityId])
}

model TestCaseRevision {
  id         String   @id @default(uuid()) @db.Uuid
  testCaseId String   @db.Uuid
  version    Int
  data       Json
  reason     String
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())
  testCase   TestCase @relation(fields: [testCaseId], references: [id])

  @@unique([testCaseId, version])
}

model Job {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  kind        String
  entityId    String       @db.Uuid
  payload     Json
  status      String       @default("queued")
  stage       String       @default("queued")
  progress    Int          @default(0)
  attempt     Int          @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdBy   String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id])
  outbox      OutboxEvent?

  @@index([status, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  jobId       String    @unique @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  job         Job       @relation(fields: [jobId], references: [id])

  @@index([publishedAt, createdAt])
}

model Export {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @db.Uuid
  idempotencyKey String
  approvedOnly   Boolean   @default(false)
  status         String    @default("queued")
  storageKey     String?
  filename       String?
  error          String?
  expiresAt      DateTime?
  createdBy      String    @db.Uuid
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  project        Project   @relation(fields: [projectId], references: [id])

  @@unique([projectId, idempotencyKey])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
}

model AgentConfigVersion {
  id            String   @id @default(uuid()) @db.Uuid
  scope         String
  scopeKey      String
  agentKey      String
  version       String
  content       String   @db.Text
  contentHash   String
  status        String   @default("DRAFT")
  lintReport    Json     @default("{}")
  evalReport    Json     @default("{}")
  approvedBy    String?  @db.Uuid
  activatedAt   DateTime?
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now())
  agentRuns     AgentRun[]

  @@unique([scope, scopeKey, agentKey, version])
  @@index([scope, scopeKey, agentKey, status])
}

model AgentRun {
  id              String              @id @default(uuid()) @db.Uuid
  projectId       String              @db.Uuid
  agentKey        String
  configVersionId String?             @db.Uuid
  snapshotId      String?             @db.Uuid
  parentRunId     String?             @db.Uuid
  status          String              @default("QUEUED")
  modelRoute      String
  promptHash      String
  inputHash       String
  inputRef        Json                @default("{}")
  outputRef       Json                @default("{}")
  validation      Json                @default("{}")
  attempt         Int                 @default(1)
  tokensIn        Int?
  tokensOut       Int?
  costCents       Int?
  durationMs      Int?
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configVersion   AgentConfigVersion? @relation(fields: [configVersionId], references: [id], onDelete: SetNull)
  parentRun       AgentRun?           @relation("AgentRunRepair", fields: [parentRunId], references: [id], onDelete: SetNull)
  repairRuns      AgentRun[]           @relation("AgentRunRepair")
  findings        AgentFinding[]

  @@index([projectId, agentKey, startedAt])
  @@index([status, startedAt])
}

model AgentFinding {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String   @db.Uuid
  targetType     String
  targetId       String   @db.Uuid
  severity       String
  code           String
  message        String   @db.Text
  suggestedFix   String   @default("") @db.Text
  resolution     String?
  resolvedBy     String?  @db.Uuid
  resolutionNote String   @default("") @db.Text
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, severity])
  @@index([targetType, targetId])
}

model AgentModelRoute {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  routeKey         String
  displayName      String
  provider         String
  model            String
  baseUrl          String
  credentialRef    String       @default("")
  fallbackRouteKey String       @default("")
  maxCostCents     Int          @default(50)
  timeoutSeconds   Int          @default(120)
  enabled          Boolean      @default(true)
  createdBy        String       @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, routeKey])
}
