generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  name        String
  externalSubject String? @unique
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())
  memberships Membership[]
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  ssoDomain   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspaces  Workspace[]
  integrations IntegrationConnection[]
}

model Workspace {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  organizationId String     @db.Uuid
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Membership {
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        Role      @default(TESTER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
}

enum Role {
  ADMIN
  QA_LEAD
  TESTER
  VIEWER
}

model IntegrationConnection {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  kind           String
  name           String
  baseUrl        String
  projectKey     String
  encryptedToken String
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalLinks  ExternalCaseLink[]

  @@unique([organizationId, kind, name])
  @@index([organizationId])
}

model ExternalCaseLink {
  id           String   @id @default(uuid()) @db.Uuid
  testCaseId   String   @db.Uuid
  integrationId String  @db.Uuid
  externalKey  String
  externalUrl  String
  contentHash  String
  syncedAt     DateTime @default(now())
  testCase     TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  integration  IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalKey])
  @@unique([testCaseId, integrationId])
}

model Project {
  id                 String                @id @default(uuid()) @db.Uuid
  workspaceId        String                @db.Uuid
  name               String
  description        String                @default("")
  domain             String                @default("")
  type               String                @default("APPLICATION")
  requirementCounter Int                   @default(0)
  scenarioCounter    Int                   @default(0)
  caseCounter        Int                   @default(0)
  version            Int                   @default(1)
  createdBy          String                @db.Uuid
  updatedBy          String                @db.Uuid
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspace          Workspace             @relation(fields: [workspaceId], references: [id])
  sources            SourceDocument[]
  requirements       Requirement[]
  snapshots          RequirementSnapshot[]
  runs               GenerationRun[]
  scenarios          Scenario[]
  testCases          TestCase[]
  jobs               Job[]
  exports            Export[]
  auditEvents        AuditEvent[]

  @@unique([workspaceId, name])
  @@index([createdBy, updatedAt])
}

model SourceDocument {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  filename     String
  mime         String
  sha256       String
  storageKey   String
  size         Int
  text         String           @default("")
  pageMap      Json             @default("[]")
  pageCount    Int?
  warnings     Json             @default("[]")
  status       String           @default("queued")
  error        String?
  version      Int              @default(1)
  createdBy    String           @db.Uuid
  updatedBy    String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  project      Project          @relation(fields: [projectId], references: [id])
  requirements Requirement[]
  citations    SourceCitation[]

  @@index([projectId, createdAt])
}

model Requirement {
  id               String                @id @default(uuid()) @db.Uuid
  projectId        String                @db.Uuid
  sourceId         String?               @db.Uuid
  stableCode       String
  text             String
  sourceLocator    Json                  @default("{}")
  excerpt          String                @default("")
  confidence       String                @default("review")
  category         String                @default("FUNCTIONAL_REQUIREMENT")
  parentStory      String                @default("")
  inferred         Boolean               @default(false)
  revision         Int                   @default(1)
  version          Int                   @default(1)
  included         Boolean               @default(true)
  status           String                @default("draft")
  outOfScopeReason String?
  createdBy        String                @db.Uuid
  updatedBy        String                @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  project          Project               @relation(fields: [projectId], references: [id])
  source           SourceDocument?       @relation(fields: [sourceId], references: [id])
  links            RequirementCaseLink[]
  revisions        RequirementRevision[]

  @@unique([projectId, stableCode])
  @@index([projectId, createdAt])
}

model RequirementRevision {
  id            String      @id @default(uuid()) @db.Uuid
  requirementId String      @db.Uuid
  revision      Int
  data          Json
  createdBy     String      @db.Uuid
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@unique([requirementId, revision])
}

model RequirementSnapshot {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  hash      String
  items     Json
  createdBy String          @db.Uuid
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id])
  runs      GenerationRun[]

  @@unique([projectId, hash])
}

model GenerationRun {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  snapshotId     String              @db.Uuid
  snapshotHash   String
  idempotencyKey String
  modelId        String
  promptVersion  String
  provider       String              @default("fixture")
  types          Json
  settings       Json                @default("{}")
  status         String              @default("queued")
  error          String?
  warnings       Json                @default("[]")
  startedAt      DateTime?
  completedAt    DateTime?
  createdBy      String              @db.Uuid
  createdAt      DateTime            @default(now())
  project        Project             @relation(fields: [projectId], references: [id])
  snapshot       RequirementSnapshot @relation(fields: [snapshotId], references: [id])
  scenarios      Scenario[]
  testCases      TestCase[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, snapshotHash, status])
}

model Scenario {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  runId       String?        @db.Uuid
  stableCode  String
  title       String
  description String         @default("")
  status      String         @default("draft")
  version     Int            @default(1)
  createdBy   String         @db.Uuid
  updatedBy   String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id])
  run         GenerationRun? @relation(fields: [runId], references: [id])
  testCases   TestCase[]

  @@unique([projectId, stableCode])
}

model TestCase {
  id             String                @id @default(uuid()) @db.Uuid
  projectId      String                @db.Uuid
  scenarioId     String?               @db.Uuid
  runId          String?               @db.Uuid
  stableCode     String
  title          String
  type           String                @default("positive")
  priority       String                @default("medium")
  preconditions  String                @default("")
  testData       String                @default("")
  postconditions String                @default("")
  rationale      String                @default("")
  reviewerNotes  String                @default("")
  status         String                @default("draft")
  stale          Boolean               @default(false)
  manual         Boolean               @default(false)
  version        Int                   @default(1)
  createdBy      String                @db.Uuid
  updatedBy      String                @db.Uuid
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  project        Project               @relation(fields: [projectId], references: [id])
  scenario       Scenario?             @relation(fields: [scenarioId], references: [id])
  run            GenerationRun?        @relation(fields: [runId], references: [id])
  steps          TestStep[]
  links          RequirementCaseLink[]
  revisions      TestCaseRevision[]
  externalLinks  ExternalCaseLink[]

  @@unique([projectId, stableCode])
  @@index([projectId, status, createdAt])
}

model TestStep {
  id             String   @id @default(uuid()) @db.Uuid
  testCaseId     String   @db.Uuid
  position       Int
  action         String
  expectedResult String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, position])
}

model RequirementCaseLink {
  requirementId String      @db.Uuid
  testCaseId    String      @db.Uuid
  rationale     String      @default("")
  createdBy     String      @db.Uuid
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  testCase      TestCase    @relation(fields: [testCaseId], references: [id])

  @@id([requirementId, testCaseId])
}

model SourceCitation {
  id         String          @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String          @db.Uuid
  sourceId   String?         @db.Uuid
  locator    Json            @default("{}")
  quote      String          @default("")
  inferred   Boolean         @default(false)
  source     SourceDocument? @relation(fields: [sourceId], references: [id])

  @@index([entityType, entityId])
}

model TestCaseRevision {
  id         String   @id @default(uuid()) @db.Uuid
  testCaseId String   @db.Uuid
  version    Int
  data       Json
  reason     String
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())
  testCase   TestCase @relation(fields: [testCaseId], references: [id])

  @@unique([testCaseId, version])
}

model Job {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  kind        String
  entityId    String       @db.Uuid
  payload     Json
  status      String       @default("queued")
  stage       String       @default("queued")
  progress    Int          @default(0)
  attempt     Int          @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdBy   String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id])
  outbox      OutboxEvent?

  @@index([status, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  jobId       String    @unique @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  job         Job       @relation(fields: [jobId], references: [id])

  @@index([publishedAt, createdAt])
}

model Export {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @db.Uuid
  idempotencyKey String
  approvedOnly   Boolean   @default(false)
  status         String    @default("queued")
  storageKey     String?
  filename       String?
  error          String?
  expiresAt      DateTime?
  createdBy      String    @db.Uuid
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  project        Project   @relation(fields: [projectId], references: [id])

  @@unique([projectId, idempotencyKey])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
}
