APP_ENV=production
DEMO_AUTH=false
APP_URL=https://testpilot.example.com
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/testpilot?sslmode=require
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379
STORAGE_MODE=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=testpilot-production
AWS_S3_ENDPOINT=
AWS_KMS_KEY_ID=
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=testpilot-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=testpilot-web
OIDC_CLIENT_SECRET=SECRET_MANAGER_REFERENCE
OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
OIDC_TOKEN_URL=https://identity.example.com/oauth/token
OIDC_END_SESSION_URL=https://identity.example.com/logout
OIDC_PASSWORD_RESET_URL=https://identity.example.com/password-reset
SCIM_BEARER_TOKEN=GENERATE_AT_LEAST_24_RANDOM_CHARACTERS
SCIM_WORKSPACE_ID=00000000-0000-4000-8000-000000000000
METRICS_BEARER_TOKEN=GENERATE_AT_LEAST_24_RANDOM_CHARACTERS
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.com/v1/traces
READINESS_MAX_QUEUE_LAG_SECONDS=300
GENERATOR_MODE=external
EXTRACTOR_MODE=external
MODEL_BASE_URL=https://model-gateway.example.com/v1
MODEL_API_KEY=SECRET_MANAGER_REFERENCE
MODEL_NAME=DEPLOYED_MODEL_NAME
INTEGRATION_ALLOWED_HOSTS=
