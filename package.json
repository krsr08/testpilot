{
  "name": "testpilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web -p 3000",
    "build": "next build apps/web",
    "start": "next start apps/web -p 3000",
    "lint": "eslint apps packages services tests --no-error-on-unmatched-pattern --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/db/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/schema.prisma",
    "db:seed": "tsx packages/db/seed.ts",
    "worker": "tsx services/worker/index.ts"
  },
  "prisma": {
    "seed": "tsx packages/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prisma/client": "6.19.3",
    "bullmq": "6.3.9",
    "docx": "^9.5.1",
    "dotenv": "18.0.4",
    "ioredis": "6.0.0",
    "jose": "6.1.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
